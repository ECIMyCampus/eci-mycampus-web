PORT=3000
NODE_ENV=development

# URL del backend (eci-mycampus-backend). Se usa al compilar: cambiarla exige recompilar.
INTERNAL_API_URL=http://localhost:4000

# Token público de Mapbox para el mapa del campus (empieza por pk.). Se usa al compilar.
# Nunca usar un token secreto (sk.): Mapbox no los permite en el navegador.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cuenta de demostración provisional: si las dos tienen valor, el inicio de sesión muestra un botón para entrar con ella.
# Se usa al compilar. Solo para desarrollo: no uses una cuenta real ni la dejes definida en producción.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
